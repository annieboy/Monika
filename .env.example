# ─────────────────────────────────────────────────────────────────────────────
# Monika — Environment Variable Template
# Copy to .env and fill in real values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development            # development | test | staging | production
PORT=3000
LOG_LEVEL=info                  # trace | debug | info | warn | error | fatal

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://monika:monika@localhost:5432/monika

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Encryption ────────────────────────────────────────────────────────────────
# 64-character hex string — generate: openssl rand -hex 32
ENCRYPTION_KEY=
# Arbitrary string (≥ 32 chars) for signing onboarding tokens
SECRET_KEY=

# ── TrueLayer (Open Banking) ──────────────────────────────────────────────────
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_REDIRECT_URI=http://localhost:3000/banking/callback
TRUELAYER_ENVIRONMENT=sandbox   # sandbox | production

# ── Anthropic / OpenAI ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=               # uncomment if using OpenAI instead

# ── WhatsApp (Meta Cloud API) ─────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=          # arbitrary string you choose
WHATSAPP_APP_SECRET=            # from Meta app dashboard
