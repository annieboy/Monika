# ─────────────────────────────────────────────────────────────────────────────
# Monika — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
SECRET_KEY=                  # 64-char hex string — generate: openssl rand -hex 32

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://monika:monika@localhost:5432/monika
# Used by Alembic (synchronous driver)
DATABASE_URL_SYNC=postgresql://monika:monika@localhost:5432/monika

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Encryption ───────────────────────────────────────────────────────────────
# Local dev only — in production this is replaced by AWS KMS
ENCRYPTION_KEY=              # 64-char hex string — generate: openssl rand -hex 32
ENCRYPTION_KEY_VERSION=1

# ── TrueLayer (Open Banking) ─────────────────────────────────────────────────
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_REDIRECT_URI=http://localhost:3000/connect/callback
TRUELAYER_ENVIRONMENT=sandbox    # sandbox | production

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── WhatsApp (Meta Cloud API) ─────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=       # arbitrary string you choose — used to verify webhook
WHATSAPP_APP_SECRET=         # from Meta app dashboard — used to verify webhook signatures

# ── AWS (production only — leave blank for local dev) ────────────────────────
AWS_REGION=eu-west-2
KMS_KEY_ID=                  # ARN of KMS key for production encryption
SQS_INBOUND_QUEUE_URL=
SQS_TRANSACTION_SYNC_QUEUE_URL=
SQS_CATEGORISATION_QUEUE_URL=
